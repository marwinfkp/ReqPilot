# ReqPilot configuration contract (ADR-011)
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Every variable is loaded into a typed Settings object; the application FAILS
# AT STARTUP on a missing or malformed required value rather than degrading at
# first use.
#
# Rule-like configuration - risk matrix, MCDA weights, expected-control
# checklists - is deliberately NOT here. It lives in versioned YAML under
# src/reqpilot/rules/data/ so that changing a rule is a data change.
#
# ALL VALUES BELOW ARE PLACEHOLDERS. No real credential belongs in this file.
#
# P0 note: the defaults work offline. No API key is required to install,
# migrate, run, or test.

# --- Application ---------------------------------------------------------
REQPILOT_ENV=development
REQPILOT_LOG_LEVEL=INFO

# Session signing key. Required outside development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
REQPILOT_SECRET_KEY=CHANGE_ME

# --- Database (ADR-003) --------------------------------------------------
# PostgreSQL 16 with pgvector. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://reqpilot:CHANGE_ME@localhost:5432/reqpilot
DATABASE_POOL_SIZE=5

# --- Orchestration (ADR-001) ---------------------------------------------
# memory = offline, no database (tests, local development)
# postgres = durable checkpoints
LANGGRAPH_CHECKPOINT_BACKEND=memory
CHECKPOINT_RETENTION_DAYS=30
NODE_TIMEOUT_SECONDS=300
MAX_NODE_FAILURES=3

# --- LLM gateway (ADR-006) -----------------------------------------------
# stub = no network, no credentials. The only provider implemented in P0.
# The concrete provider and model tier remain open decisions; the values below
# are configuration placeholders, not architectural commitments.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_REASONING=
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# Recorded-fixture mode: replay = deterministic, offline, zero cost (default).
LLM_FIXTURE_MODE=replay
LLM_FIXTURE_DIR=tests/fixtures/llm

# --- Retrieval (architecture J.4) -----------------------------------------
# Chunks returned per retrieval by default. The relevance threshold that decides
# the FR-RAG-005 "nothing relevant" outcome is versioned rule data, per model,
# in src/reqpilot/rules/data/retrieval.yaml - not an environment setting.
RETRIEVAL_TOP_K=8

# --- Embeddings (architecture ADR-005) -------------------------------------
# sentence_transformers = the approved local CPU model (no API, no key).
#   Needs the optional extra:  pip install -e ".[embeddings]"
# hashing = deterministic, NON-semantic stand-in for offline tests only;
#   refused when REQPILOT_ENV=production.
EMBEDDING_PROVIDER=sentence_transformers
# The approved model. Changing it requires a re-embed migration (ADR-004).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# false = never reach the network; an uncached model fails with instructions.
# Set true once at setup to download the ~120 MB model into the local cache.
EMBEDDING_ALLOW_DOWNLOAD=false

# --- Deterministic rules -------------------------------------------------
RULES_DIR=src/reqpilot/rules/data

# --- Audit (ADR-010) -----------------------------------------------------
AUDIT_HASH_CHAIN_ENABLED=true

# --- Data locations ------------------------------------------------------
KB_SEED_DIR=data/kb_seed
GOLD_DATA_DIR=data/gold
DEV_DATA_DIR=data/dev

# --- Feature flags -------------------------------------------------------
MASKING_ENABLED=true
INJECTION_DETECTION_ENABLED=true

# --- Retention (FR-ADM-006) ----------------------------------------------
TRANSCRIPT_RETENTION_DAYS=365

# --- Test-only -----------------------------------------------------------
# Set to a live PostgreSQL URL to enable the PostgreSQL-specific integration
# tests. They skip cleanly when it is unset.
REQPILOT_TEST_DATABASE_URL=
