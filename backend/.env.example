# ---------------------------------------------------------------
# ReqPilot backend configuration (copy to backend/.env)
# ---------------------------------------------------------------

# PostgreSQL + pgvector (started with `docker compose up -d` in the project root)
DATABASE_URL=postgresql+psycopg://reqpilot:reqpilot@localhost:5433/reqpilot

# OpenAI - the only runtime LLM provider. Leave OPENAI_API_KEY empty to run in
# clearly-labelled DEMONSTRATION mode (rule-based agents only, no AI calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3
LLM_CONCURRENCY=4
LLM_BATCH_SIZE=20

# Security
SESSION_HOURS=12
COOKIE_SECURE=false
MAX_UPLOAD_MB=10
MAX_REQUIREMENTS_CHARS=300000
DEFAULT_RETENTION_DAYS=365
FRONTEND_ORIGIN=http://localhost:3000

# Password of the seeded demo accounts (admin@reqpilot.local, analyst@..., etc.)
DEMO_USER_PASSWORD=ReqPilot@2026
